# UrLynk API configuration.
# Copy to backend/.env for local development. Never commit backend/.env.
# On a hosting provider (e.g. Render), set these as environment variables instead.

# development | test | production. Production disables /docs and rejects CORS "*".
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# postgres:// and postgresql:// URLs are accepted and use the psycopg driver.
# Managed providers usually need TLS: append ?sslmode=require
DATABASE_URL=postgresql://urlynk:CHANGE_ME@localhost:5432/urlynk

# Connection pool (per API process). Defaults shown.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_CONNECT_TIMEOUT_SECONDS=5
# Per-statement limit in ms. Set 0 if a connection pooler rejects startup options.
# DB_STATEMENT_TIMEOUT_MS=10000

# --- Clerk -------------------------------------------------------------------
# Your Clerk instance's Frontend API URL. Find it in the Clerk Dashboard under
# API keys ("Frontend API URL"). Development instances look like
# https://<name>.clerk.accounts.dev ; production instances use your own domain.
# Tokens whose `iss` claim differs from this value are rejected.
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev

# Optional. Defaults to CLERK_ISSUER + /.well-known/jwks.json (public keys only).
# CLERK_JWKS_URL=

# Optional, comma-separated. Accepted values of the token `azp` claim. Clerk sets
# `azp` from the Origin header of browser requests; tokens without `azp` (common for
# native apps) are still accepted. Leave empty unless you serve a web client.
# CLERK_AUTHORIZED_PARTIES=https://app.example.com

# Optional token checks. Defaults shown.
# JWT_LEEWAY_SECONDS=5
# JWKS_CACHE_TTL_SECONDS=3600
# JWKS_MIN_REFRESH_INTERVAL_SECONDS=60
# JWKS_FETCH_TIMEOUT_SECONDS=5

# No Clerk secret key is needed: tokens are verified with Clerk's public keys.

# --- CORS --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. The Android app does not
# need CORS. Leave empty unless a web client calls the API.
CORS_ORIGINS=
