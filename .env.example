# Mobile app configuration. Copy to .env (git-ignored) and fill in.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone with the APK:
# only public values belong here. Backend secrets live in backend/.env, never here.

# Clerk Dashboard -> API keys -> Publishable key (pk_test_... or pk_live_...).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# UrLynk backend base URL, without a trailing slash.
# Development over USB: run `adb reverse tcp:8000 tcp:8000`, then use http://localhost:8000
# Production builds require https://.
EXPO_PUBLIC_API_URL=http://localhost:8000
