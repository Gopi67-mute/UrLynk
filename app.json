{
  "expo": {
    "name": "UrLynk",
    "slug": "UrLynk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "urlynk",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#6C3AED",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jdaloo.UrLynk"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/urlynk-splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#FFFFFF",
            "cropToolbarIconColor": "#0F172A",
            "cropToolbarActionTextColor": "#6C3AED",
            "cropBackButtonIconColor": "#0F172A",
            "cropBackgroundColor": "#F8FAFC"
          }
        }
      ],
      "./plugins/with-short-cmake-object-paths",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8287fd9-6425-45a9-9ad8-89c5ca5d13f8"
      }
    },
    "owner": "jdaloo"
  }
}
